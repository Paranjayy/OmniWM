{
  "name": "omniwm",
  "title": "OmniWM",
  "description": "Control OmniWM from Raycast",
  "icon": "command-icon.png",
  "author": "barutsrb",
  "license": "MIT",
  "commands": [
    {
      "name": "run-command",
      "title": "Run OmniWM Command",
      "description": "Execute any native OmniWM command",
      "mode": "view"
    },
    {
      "name": "visualize-shortcuts",
      "title": "Visualize Shortcuts",
      "description": "Display keyboard shortcuts parsed from Karabiner",
      "mode": "view"
    },
    {
      "name": "search-windows",
      "title": "Search Windows",
      "description": "List and focus managed windows",
      "mode": "view"
    },
    {
      "name": "switch-workspace",
      "title": "Switch Workspace",
      "description": "Switch to a specific workspace",
      "mode": "view"
    },
    {
      "name": "toggle-bar",
      "title": "Toggle Workspace Bar",
      "description": "Toggle the visibility of the OmniWM bar",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.72.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "20.8.10",
    "@types/react": "18.2.27",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
