{
    "title": "OmniKey v12 - POSITION & FOCUS REBORN",
    "rules": [
        {
            "description": "[Trigger] Right Option -> Nav/Focus Layer (Skip if Shift held)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": { "key_code": "right_option", "modifiers": { "optional": ["any"] } },
                    "conditions": [{ "type": "modifier_if", "on": ["shift"], "halt": true }],
                    "to": [{ "set_variable": { "name": "right_opt_layer", "value": 1 } }],
                    "to_after_key_up": [{ "set_variable": { "name": "right_opt_layer", "value": 0 } }],
                    "to_if_alone": [{ "key_code": "right_option" }],
                    "parameters": { "basic.to_if_alone_timeout_milliseconds": 150 }
                }
            ]
        },
        {
            "description": "[Trigger] Right Command -> Window Management Layer",
            "manipulators": [
                {
                    "type": "basic",
                    "from": { "key_code": "right_command", "modifiers": { "optional": ["any"] } },
                    "to": [{ "set_variable": { "name": "rcmd_layer", "value": 1 } }],
                    "to_after_key_up": [{ "set_variable": { "name": "rcmd_layer", "value": 0 } }],
                    "to_if_alone": [{ "key_code": "right_command" }],
                    "parameters": { "basic.to_if_alone_timeout_milliseconds": 150 }
                }
            ]
        },
        {
            "description": "[Right Opt Layer] WASD/Arrows=FOCUS | HJKL=Words | 1-9=Focus Column",
            "manipulators": [
                { "type": "basic", "from": { "key_code": "w" }, "to": [{ "key_code": "up_arrow", "modifiers": ["option", "command", "control", "shift"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "a" }, "to": [{ "key_code": "left_arrow", "modifiers": ["option", "command", "control", "shift"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "s" }, "to": [{ "key_code": "down_arrow", "modifiers": ["option", "command", "control", "shift"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "d" }, "to": [{ "key_code": "right_arrow", "modifiers": ["option", "command", "control", "shift"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "1" }, "to": [{ "key_code": "1", "modifiers": ["option", "command", "control"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "2" }, "to": [{ "key_code": "2", "modifiers": ["option", "command", "control"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "3" }, "to": [{ "key_code": "3", "modifiers": ["option", "command", "control"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "h" }, "to": [{ "key_code": "left_arrow", "modifiers": ["option"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "l" }, "to": [{ "key_code": "right_arrow", "modifiers": ["option"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "j" }, "to": [{ "key_code": "page_down" }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "k" }, "to": [{ "key_code": "page_up" }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "u" }, "to": [{ "key_code": "left_arrow", "modifiers": ["command"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "o" }, "to": [{ "key_code": "right_arrow", "modifiers": ["command"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "left_arrow" }, "to": [{ "key_code": "left_arrow", "modifiers": ["option"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "right_arrow" }, "to": [{ "key_code": "right_arrow", "modifiers": ["option"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] }
            ]
        },
        {
            "description": "[RCmd Layer] WASD=POSITION (Move) | Shift+WASD=RESIZE | F/Enter=Fullscreen | 1-9=WSpace Switch",
            "manipulators": [
                { "type": "basic", "from": { "key_code": "w" }, "to": [{ "key_code": "w", "modifiers": ["option", "command", "control", "shift"] }], "conditions": [{ "type": "variable_if", "name": "rcmd_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "a" }, "to": [{ "key_code": "a", "modifiers": ["option", "command", "control", "shift"] }], "conditions": [{ "type": "variable_if", "name": "rcmd_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "s" }, "to": [{ "key_code": "s", "modifiers": ["option", "command", "control", "shift"] }], "conditions": [{ "type": "variable_if", "name": "rcmd_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "d" }, "to": [{ "key_code": "d", "modifiers": ["option", "command", "control", "shift"] }], "conditions": [{ "type": "variable_if", "name": "rcmd_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "f" }, "to": [{ "key_code": "return_or_enter", "modifiers": ["option", "command", "control", "shift"] }], "conditions": [{ "type": "variable_if", "name": "rcmd_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "return_or_enter" }, "to": [{ "key_code": "return_or_enter", "modifiers": ["option", "command", "control", "shift"] }], "conditions": [{ "type": "variable_if", "name": "rcmd_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "g" }, "to": [{ "key_code": "spacebar", "modifiers": ["option", "command", "control", "shift"] }], "conditions": [{ "type": "variable_if", "name": "rcmd_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "l" }, "to": [{ "key_code": "l", "modifiers": ["option", "command", "control", "shift"] }], "conditions": [{ "type": "variable_if", "name": "rcmd_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "1" }, "to": [{ "key_code": "1", "modifiers": ["option", "command", "control", "shift"] }], "conditions": [{ "type": "variable_if", "name": "rcmd_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "2" }, "to": [{ "key_code": "2", "modifiers": ["option", "command", "control", "shift"] }], "conditions": [{ "type": "variable_if", "name": "rcmd_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "3" }, "to": [{ "key_code": "3", "modifiers": ["option", "command", "control", "shift"] }], "conditions": [{ "type": "variable_if", "name": "rcmd_layer", "value": 1 }] }
            ]
        },
        {
            "description": "[Sequences] Hyper+A=Launch Apps",
            "manipulators": [
                {
                    "type": "basic",
                    "from": { "key_code": "a", "modifiers": { "mandatory": ["command", "option", "control", "shift"] } },
                    "to": [{ "set_variable": { "name": "seq_a", "value": 1 } }],
                    "to_delayed_action": { "to_if_invoked": [{ "set_variable": { "name": "seq_a", "value": 0 } }], "to_if_canceled": [{ "set_variable": { "name": "seq_a", "value": 0 } }] },
                    "parameters": { "basic.to_delayed_action_delay_milliseconds": 1500 }
                },
                { "type": "basic", "from": { "key_code": "a" }, "to": [{ "shell_command": "open -a Arc" }, { "set_variable": { "name": "seq_a", "value": 0 } }], "conditions": [{ "type": "variable_if", "name": "seq_a", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "c" }, "to": [{ "shell_command": "open -a Cursor" }, { "set_variable": { "name": "seq_a", "value": 0 } }], "conditions": [{ "type": "variable_if", "name": "seq_a", "value": 1 }] }
            ]
        }
    ]
}
