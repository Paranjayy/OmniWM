{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "[Trigger] Right Option -> Nav Layer (pure variable, tap sends ropt)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "right_option",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    { "set_variable": { "name": "right_opt_layer", "value": 1 } }
                                ],
                                "to_after_key_up": [
                                    { "set_variable": { "name": "right_opt_layer", "value": 0 } }
                                ],
                                "to_if_alone": [
                                    { "key_code": "right_option" }
                                ],
                                "parameters": {
                                    "basic.to_if_alone_timeout_milliseconds": 200
                                }
                            }
                        ]
                    },
                    {
                        "description": "[Trigger] Right Command -> WM Layer (pure variable, tap sends rcmd)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "right_command",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    { "set_variable": { "name": "rcmd_layer", "value": 1 } }
                                ],
                                "to_after_key_up": [
                                    { "set_variable": { "name": "rcmd_layer", "value": 0 } }
                                ],
                                "to_if_alone": [
                                    { "key_code": "right_command" }
                                ],
                                "parameters": {
                                    "basic.to_if_alone_timeout_milliseconds": 200
                                }
                            }
                        ]
                    },
