{
    "title": "OmniKey v20 - FIXED MODIFIERS",
    "rules": [
        {
            "description": "[Trigger] Right Option -> Nav/Focus Layer (Swallowed unless alone)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": { "key_code": "right_option", "modifiers": { "optional": ["any"] } },
                    "to": [ { "set_variable": { "name": "right_opt_layer", "value": 1 } } ],
                    "to_after_key_up": [ { "set_variable": { "name": "right_opt_layer", "value": 0 } } ],
                    "to_if_alone": [ { "key_code": "right_option" } ],
                    "parameters": { "basic.to_if_alone_timeout_milliseconds": 150 }
                }
            ]
        },
        {
            "description": "[Trigger] Right Command -> Window Management Layer (Swallowed unless alone)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": { "key_code": "right_command", "modifiers": { "optional": ["any"] } },
                    "to": [ { "set_variable": { "name": "rcmd_layer", "value": 1 } } ],
                    "to_after_key_up": [ { "set_variable": { "name": "rcmd_layer", "value": 0 } } ],
                    "to_if_alone": [ { "key_code": "right_command" } ],
                    "parameters": { "basic.to_if_alone_timeout_milliseconds": 150 }
                }
            ]
        },
        {
            "description": "[Nav Layer] WASD -> Focus Up/Down/Left/Right | 1-9 -> Focus Workspace",
            "manipulators": [
                { "type": "basic", "from": { "key_code": "w" }, "to": [{ "key_code": "up_arrow", "modifiers": ["left_option", "left_control"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "s" }, "to": [{ "key_code": "down_arrow", "modifiers": ["left_option", "left_control"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "a" }, "to": [{ "key_code": "left_arrow", "modifiers": ["left_option", "left_control"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "d" }, "to": [{ "key_code": "right_arrow", "modifiers": ["left_option", "left_control"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "1" }, "to": [{ "key_code": "1", "modifiers": ["left_option"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "2" }, "to": [{ "key_code": "2", "modifiers": ["left_option"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "3" }, "to": [{ "key_code": "3", "modifiers": ["left_option"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "4" }, "to": [{ "key_code": "4", "modifiers": ["left_option"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "5" }, "to": [{ "key_code": "5", "modifiers": ["left_option"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "6" }, "to": [{ "key_code": "6", "modifiers": ["left_option"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "7" }, "to": [{ "key_code": "7", "modifiers": ["left_option"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "8" }, "to": [{ "key_code": "8", "modifiers": ["left_option"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "9" }, "to": [{ "key_code": "9", "modifiers": ["left_option"] }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "h" }, "to": [{ "key_code": "left_arrow" }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "l" }, "to": [{ "key_code": "right_arrow" }], "conditions": [{ "type": "variable_if", "name": "right_opt_layer", "value": 1 }] }
            ]
        },
        {
            "description": "[Window Layer] WASD -> Move Up/Down/Left/Right | F/Enter -> Fullscreen",
            "manipulators": [
                { "type": "basic", "from": { "key_code": "w" }, "to": [{ "key_code": "up_arrow", "modifiers": ["left_control", "left_shift"] }], "conditions": [{ "type": "variable_if", "name": "rcmd_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "s" }, "to": [{ "key_code": "down_arrow", "modifiers": ["left_control", "left_shift"] }], "conditions": [{ "type": "variable_if", "name": "rcmd_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "a" }, "to": [{ "key_code": "left_arrow", "modifiers": ["left_control", "left_shift"] }], "conditions": [{ "type": "variable_if", "name": "rcmd_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "d" }, "to": [{ "key_code": "right_arrow", "modifiers": ["left_control", "left_shift"] }], "conditions": [{ "type": "variable_if", "name": "rcmd_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "f" }, "to": [{ "key_code": "return_or_enter", "modifiers": ["left_control"] }], "conditions": [{ "type": "variable_if", "name": "rcmd_layer", "value": 1 }] },
                { "type": "basic", "from": { "key_code": "return_or_enter" }, "to": [{ "key_code": "return_or_enter", "modifiers": ["left_control"] }], "conditions": [{ "type": "variable_if", "name": "rcmd_layer", "value": 1 }] }
            ]
        },
        {
            "description": "[Global] Media Keys Path-through (Shift+Opt optional any check)",
            "manipulators": [
                {
                   "type": "basic",
                   "from": {
                       "key_code": "apple_vendor_top_case_key_brightness_up",
                       "modifiers": { "optional": ["any"] }
                   },
                   "to": [ { "key_code": "apple_vendor_top_case_key_brightness_up" } ]
                },
                {
                   "type": "basic",
                   "from": {
                       "key_code": "apple_vendor_top_case_key_brightness_down",
                       "modifiers": { "optional": ["any"] }
                   },
                   "to": [ { "key_code": "apple_vendor_top_case_key_brightness_down" } ]
                }
            ]
        }
    ]
}
